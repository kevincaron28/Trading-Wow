{
  "name": "goldline",
  "version": "1.1.1",
  "private": true,
  "description": "Goldline: auction house price charts for World of Warcraft Forever.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && vite build",
    "probe:blizzard": "node --env-file-if-exists=.env scripts/probe-blizzard.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/background-runner": "3.0.0",
    "@capacitor/core": "8.6.2",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/share": "8.0.3",
    "@capawesome/capacitor-app-update": "8.1.1",
    "@capgo/capacitor-updater": "8.54.0",
    "lightweight-charts": "5.3.0",
    "preact": "11.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "goldline": {
    "minNativeBuild": 10101
  }
}
