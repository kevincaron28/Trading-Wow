{
  "name": "goldline",
  "version": "0.1.0",
  "private": true,
  "description": "Goldline: auction house price charts for World of Warcraft Forever.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && vite build",
    "probe:blizzard": "node --env-file-if-exists=.env scripts/probe-blizzard.mjs"
  },
  "dependencies": {
    "lightweight-charts": "5.3.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
